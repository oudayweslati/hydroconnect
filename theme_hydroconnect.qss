/* Theme HydroConnect - couleurs mesurees sur la capture */
QMainWindow, QWidget#page { background-color: #f6f9ff; }
QWidget { font-family: "Segoe UI", sans-serif; font-size: 9pt; color: #0b2a55; }

/* Menu lateral : bleu marine (au lieu de noir) */
QFrame#sidebar { background-color: #0b2a55; }
QFrame#sidebar QLabel { color: white; background: transparent; }
QLabel#logoText { font-size: 14pt; font-weight: bold; color: white; }
QFrame#sidebar QPushButton {
    background: transparent; color: #e8eefb; border: none;
    text-align: left; padding: 10px 14px; border-radius: 10px;
}
QFrame#sidebar QPushButton:hover { background-color: rgba(255,255,255,0.08); }
QFrame#sidebar QPushButton:checked { background-color: #2f6fed; color: white; font-weight: bold; }

QLabel#pageTitle { font-size: 18pt; font-weight: bold; color: #0b2a55; }
QLabel#pageSub { color: #6b7a99; }

QFrame#card, QFrame#panel { background: white; border: 1px solid #e3e9f5; border-radius: 16px; }
QLabel#cardTitle { color: #6b7a99; font-weight: bold; font-size: 8pt; background: transparent; }
QLabel#cardValue { font-size: 15pt; font-weight: bold; background: transparent; }
QLabel#cardSub { color: #8a97b2; font-size: 8pt; background: transparent; }
QLabel#tag { border-radius: 8px; padding: 6px 10px; font-weight: bold; font-size: 8pt; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: white; border: 1px solid #d5ddef; border-radius: 8px; padding: 6px 8px;
}
QPushButton#primary { background: #2f6fed; color: white; border: none; border-radius: 8px; padding: 8px 16px; font-weight: bold; }
QPushButton#primary:hover { background: #2559c4; }
QPushButton#soft { background: #e8f0ff; color: #2f6fed; border: none; border-radius: 8px; padding: 8px 14px; font-weight: bold; }
QPushButton#outline { background: white; color: #0b2a55; border: 1px solid #d5ddef; border-radius: 8px; padding: 8px 14px; font-weight: bold; }

QTableView { background: white; border: none; alternate-background-color: #f4f7fd; gridline-color: transparent; selection-background-color: #dbe7ff; selection-color: #0b2a55; }
QHeaderView::section { background: #e8f0ff; color: #0b2a55; border: none; padding: 10px; font-weight: bold; }

QTabWidget::pane { border: 1px solid #e3e9f5; background: white; border-radius: 8px; }
QTabBar::tab { background: #eef3fc; padding: 10px 18px; font-weight: bold; }
QTabBar::tab:selected { background: white; color: #2f6fed; border-bottom: 2px solid #2f6fed; }
QTextBrowser { background: #f6f9ff; border: 1px solid #e3e9f5; border-radius: 8px; padding: 8px; }
